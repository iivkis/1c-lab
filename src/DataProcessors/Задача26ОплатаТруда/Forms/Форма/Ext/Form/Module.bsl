// Управляемая форма обработки Задача26ОплатаТруда.
&НаСервере
Процедура РассчитатьНаСервере()

    ОбработкаРасчета = РеквизитФормыВЗначение("Объект");
    РезультатРасчета = ОбработкаРасчета.Рассчитать(ПочасоваяСтавка, Часы, СтавкаНДФЛ);
    Начислено = РезультатРасчета.Начислено;
    НДФЛ = РезультатРасчета.НДФЛ;
    ПрофсоюзныеВзносы = РезультатРасчета.ПрофсоюзныеВзносы;
    КВыдаче = РезультатРасчета.КВыдаче;

КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)

    Попытка
        РассчитатьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
