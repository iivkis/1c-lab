// Интерактивная форма анализа складских данных.
&НаСервере
Функция СформироватьНаСервере()
    Обработка = РеквизитФормыВЗначение("Объект");
    Возврат Обработка.СформироватьАнализ(Склад);
КонецФункции

&НаКлиенте
Процедура Анализировать(Команда)
    Попытка
        ТабДок = СформироватьНаСервере();
        ТабДок.Показать("Анализ остатков склада");
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
