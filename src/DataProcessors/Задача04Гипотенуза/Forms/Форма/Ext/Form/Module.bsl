// Управляемая форма обработки Задача04Гипотенуза.
&НаСервере
Процедура РассчитатьНаСервере()

    ОбработкаРасчета = РеквизитФормыВЗначение("Объект");
    Гипотенуза = Окр(ОбработкаРасчета.Рассчитать(КатетА, КатетБ), 3);

КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)

    Попытка
        РассчитатьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
