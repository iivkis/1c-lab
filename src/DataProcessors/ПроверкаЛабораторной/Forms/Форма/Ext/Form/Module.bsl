// Запуск тестов на текущей учебной базе.
&НаСервере
Функция ВыполнитьНаСервере()
    Обработка = РеквизитФормыВЗначение("Объект");
    Возврат Обработка.ВыполнитьПроверки();
КонецФункции

&НаКлиенте
Процедура Проверить(Команда)
    РезультатПроверки = "Выполняется проверка...";
    Попытка
        РезультатПроверки = ВыполнитьНаСервере();
    Исключение
        РезультатПроверки = "ОШИБКА: " + ОписаниеОшибки();
    КонецПопытки;
    Сообщить(РезультатПроверки);
КонецПроцедуры
