// Приёмочные сценарии учебной лабораторной.
// ВНИМАНИЕ: создают тестовые справочники и накладные в текущей базе.
// Запускать на учебной копии информационной базы, не на продуктивных данных.

Процедура ПроверитьУсловие(Условие, ТекстОшибки)

    Если Не Условие Тогда
        ВызватьИсключение ТекстОшибки;
    КонецЕсли;

КонецПроцедуры

Функция НовыйТовар(Ключ)

    Товар = Справочники.Товары.СоздатьЭлемент();
    Товар.Наименование = "Кирпич тест " + Ключ;
    Товар.МинимальныйОстаток = 1000;
    Товар.Записать();
    Возврат Товар.Ссылка;

КонецФункции

Функция НовыйСклад(Ключ)

    Склад = Справочники.Склады.СоздатьЭлемент();
    Склад.Наименование = "Тестовый склад " + Ключ;
    Склад.Записать();
    Возврат Склад.Ссылка;

КонецФункции

Функция НовыйПоставщик(Ключ)

    Поставщик = Справочники.Поставщики.СоздатьЭлемент();
    Поставщик.Наименование = "Тестовый поставщик " + Ключ;
    Поставщик.Записать();
    Возврат Поставщик.Ссылка;

КонецФункции

Функция НовыйПолучатель(Ключ)

    Получатель = Справочники.Получатели.СоздатьЭлемент();
    Получатель.Наименование = "Тестовый получатель " + Ключ;
    Получатель.Записать();
    Возврат Получатель.Ссылка;

КонецФункции

Процедура Оприходовать(Склад, Поставщик, Товар, Количество)

    Накладная = Документы.ПриходнаяНакладная.СоздатьДокумент();
    Накладная.Дата = ТекущаяДата();
    Накладная.Склад = Склад;
    Накладная.Поставщик = Поставщик;
    СтрокаДокумента = Накладная.Товары.Добавить();
    СтрокаДокумента.Товар = Товар;
    СтрокаДокумента.Количество = Количество;
    Накладная.Записать(РежимЗаписиДокумента.Проведение);

    ПроверитьУсловие(Накладная.Проведен, "Приходная накладная не проведена.");

КонецПроцедуры

Функция СоздатьРасход(Склад, Получатель, Товар, Количество)

    Накладная = Документы.РасходнаяНакладная.СоздатьДокумент();
    Накладная.Дата = ТекущаяДата();
    Накладная.Склад = Склад;
    Накладная.Получатель = Получатель;
    СтрокаДокумента = Накладная.Товары.Добавить();
    СтрокаДокумента.Товар = Товар;
    СтрокаДокумента.Количество = Количество;
    Возврат Накладная;

КонецФункции

Процедура ПроверитьОтказОтЗаписи(Накладная)

    Попытка
        Накладная.Записать();
    Исключение
        // При отказе платформа может выбросить исключение: это ожидаемо.
    КонецПопытки;

    ПроверитьУсловие(
        Накладная.ЭтоНовый(),
        "Недопустимая расходная накладная была записана.");

КонецПроцедуры

Процедура ПроверитьОтказОтПроведения(Накладная)

    Попытка
        Накладная.Записать(РежимЗаписиДокумента.Проведение);
    Исключение
        // Ошибка проведения допустима только если документ не проведен.
    КонецПопытки;

    ПроверитьУсловие(
        Накладная.ЭтоНовый() Или Не Накладная.Проведен,
        "Недопустимая расходная накладная проведена.");

КонецПроцедуры

Процедура ПроверитьДополнительныеЗадачи()

    Задача4 = Обработки.Задача04Гипотенуза.Создать();
    ПроверитьУсловие(
        Задача4.Рассчитать(3, 4) = 5,
        "Ошибка задачи №4.");

    Задача12 = Обработки.Задача12СуммаКвадратов.Создать();
    ПроверитьУсловие(
        Задача12.Рассчитать(6, 8) = 10,
        "Ошибка задачи №12.");

    Задача22 = Обработки.Задача22Водоснабжение.Создать();
    Результат22 = Задача22.Рассчитать(120, 135, 40);
    ПроверитьУсловие(
        Результат22.РасходКубометров = 15 И Результат22.СуммаОплаты = 600,
        "Ошибка задачи №22.");

    Задача26 = Обработки.Задача26ОплатаТруда.Создать();
    Результат26 = Задача26.Рассчитать(500, 160, 13);
    ПроверитьУсловие(
        Результат26.Начислено = 80000
            И Результат26.НДФЛ = 10400
            И Результат26.ПрофсоюзныеВзносы = 800
            И Результат26.КВыдаче = 68800,
        "Ошибка задачи №26.");

КонецПроцедуры

Функция ВыполнитьПроверки() Экспорт

    ПроверитьДополнительныеЗадачи();
    Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);

    Товар = НовыйТовар(Ключ);
    Склад1 = НовыйСклад("1 " + Ключ);
    Склад2 = НовыйСклад("2 " + Ключ);
    Склад3 = НовыйСклад("3 " + Ключ);
    Поставщик = НовыйПоставщик(Ключ);
    Получатель = НовыйПолучатель(Ключ);

    Оприходовать(Склад1, Поставщик, Товар, 10000);
    Оприходовать(Склад2, Поставщик, Товар, 2500);
    Оприходовать(Склад3, Поставщик, Товар, 10000);

    ПроверитьУсловие(
        СкладскойУчетСервер.ПолучитьТекущийОстаток(Склад1, Товар) = 10000,
        "Неверный остаток после прихода на склад 1.");
    ПроверитьУсловие(
        СкладскойУчетСервер.ПолучитьТекущийОстаток(Склад2, Товар) = 2500,
        "Неверный остаток после прихода на склад 2.");

    // Сценарий 3 ТЗ: расход 9001 при остатке 10000 и минимуме 1000 запрещен.
    ОшибочнаяНакладная = СоздатьРасход(Склад1, Получатель, Товар, 9001);
    ПроверитьОтказОтЗаписи(ОшибочнаяНакладная);
    ПроверитьОтказОтПроведения(ОшибочнаяНакладная);
    ПроверитьУсловие(
        СкладскойУчетСервер.ПолучитьТекущийОстаток(Склад1, Товар) = 10000,
        "Недопустимая накладная изменила остаток.");

    // Сценарий 2: разрешена выдача ровно до минимума.
    ВернаяНакладная = СоздатьРасход(Склад1, Получатель, Товар, 9000);
    ВернаяНакладная.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьУсловие(ВернаяНакладная.Проведен, "Расход ровно до минимума отклонен.");
    ПроверитьУсловие(
        СкладскойУчетСервер.ПолучитьТекущийОстаток(Склад1, Товар) = 1000,
        "Неверный остаток после разрешенного расхода.");

    // Сценарий 4: независимость остатков складов.
    ПроверитьУсловие(
        СкладскойУчетСервер.ПолучитьТекущийОстаток(Склад2, Товар) = 2500,
        "Движение склада 1 изменило остаток склада 2.");
    РасходДругогоСклада = СоздатьРасход(Склад2, Получатель, Товар, 1501);
    ПроверитьОтказОтПроведения(РасходДругогоСклада);

    // Сценарий 5: две строки одного товара должны проверяться суммарно.
    Повтор = СоздатьРасход(Склад3, Получатель, Товар, 6000);
    СтрокаПовтора = Повтор.Товары.Добавить();
    СтрокаПовтора.Товар = Товар;
    СтрокаПовтора.Количество = 3001;
    ПроверитьОтказОтПроведения(Повтор);
    ПроверитьУсловие(
        СкладскойУчетСервер.ПолучитьТекущийОстаток(Склад3, Товар) = 10000,
        "Повтор товара обошел контроль минимума.");

    // Отчеты должны брать остатки/обороты из регистров.
    ДанныеОтчета = СкладскиеОтчетыСервер.КонтрольМинимальныхОстатков(
        НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()), Склад1);
    ПроверитьУсловие(ДанныеОтчета.Количество() > 0, "Отчет по остаткам пуст.");

    Возврат "ПРОЙДЕНО: задачи №4, 12, 22, 26; приход; отказ от записи;"
        + " отказ от проведения; граница минимума; независимость складов;"
        + " повтор товара; базовый запрос отчета. Созданы тестовые данные: " + Ключ;

КонецФункции
