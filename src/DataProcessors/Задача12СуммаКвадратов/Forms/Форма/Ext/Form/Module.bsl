// Управляемая форма обработки Задача12СуммаКвадратов.
&НаСервере
Процедура РассчитатьНаСервере()

    ОбработкаРасчета = РеквизитФормыВЗначение("Объект");
    Результат = Окр(ОбработкаРасчета.Рассчитать(Число1, Число2), 3);

КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)

    Попытка
        РассчитатьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
