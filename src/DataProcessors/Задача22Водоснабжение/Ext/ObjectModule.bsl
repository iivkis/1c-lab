// Задание №22. Сброс и переполнение счетчика по ТЗ не предусмотрены.
Функция Рассчитать(НачальноеПоказание, КонечноеПоказание, Тариф) Экспорт

    Если НачальноеПоказание < 0 Или КонечноеПоказание < НачальноеПоказание Тогда
        ВызватьИсключение "Конечное показание не может быть меньше начального.";
    КонецЕсли;

    Если Тариф < 0 Тогда
        ВызватьИсключение "Тариф не может быть отрицательным.";
    КонецЕсли;

    РасходКубометров = КонечноеПоказание - НачальноеПоказание;
    СуммаОплаты = Окр(РасходКубометров * Тариф, 2);

    Возврат Новый Структура(
        "РасходКубометров,СуммаОплаты", РасходКубометров, СуммаОплаты);

КонецФункции
