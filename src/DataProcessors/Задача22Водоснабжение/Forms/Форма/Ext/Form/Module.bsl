&НаСервере
Процедура РассчитатьНаСервере()

    ОбработкаРасчета = РеквизитФормыВЗначение("Объект");
    РезультатРасчета = ОбработкаРасчета.Рассчитать(НачальноеПоказание, КонечноеПоказание, Тариф);
    РасходКубометров = РезультатРасчета.РасходКубометров;
    СуммаОплаты = РезультатРасчета.СуммаОплаты;

КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)

    Попытка
        РассчитатьНаСервере();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
