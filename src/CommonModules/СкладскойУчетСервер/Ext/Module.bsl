// Общий модуль СкладскойУчетСервер.
// Свойства метаданных: Сервер = Истина; ВызовСервера = Ложь; Глобальный = Ложь.
// Контроль выполняется отдельно для одного склада.
// Для простоты учебной версии не поддерживается задним числом пересчет цепочки документов.

Функция ОшибкаЗаполненияНакладной(Склад, Контрагент, СтрокиТоваров) Экспорт

    Если Не ЗначениеЗаполнено(Склад) Тогда
        Возврат "Не выбран склад.";
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Контрагент) Тогда
        Возврат "Не выбран поставщик или получатель.";
    КонецЕсли;

    Если СтрокиТоваров.Количество() = 0 Тогда
        Возврат "В накладной должна быть хотя бы одна строка с товаром.";
    КонецЕсли;

    Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
            Возврат "В табличной части есть строка без товара.";
        КонецЕсли;

        Если СтрокаТовара.Количество <= 0 Тогда
            Возврат СтрШаблон(
                "Количество товара %1 должно быть больше нуля.",
                СтрокаТовара.Товар);
        КонецЕсли;
    КонецЦикла;

    Возврат "";

КонецФункции

// Объединяет строки одного товара: нельзя обходить ограничение двумя строками.
Функция КоличестваПоТоварам(СтрокиТоваров) Экспорт

    Результат = Новый Соответствие;

    Для Каждого СтрокаТовара Из СтрокиТоваров Цикл
        СтароеКоличество = Результат.Получить(СтрокаТовара.Товар);

        Если СтароеКоличество = Неопределено Тогда
            СтароеКоличество = 0;
        КонецЕсли;

        Результат.Вставить(
            СтрокаТовара.Товар,
            СтароеКоличество + СтрокаТовара.Количество);
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Текущие остатки из регистра ОстаткиТоваров (отсутствующая строка = 0).
Функция ОстаткиПоТоварам(Склад, Количества) Экспорт

    Остатки = Новый Соответствие;
    СписокТоваров = Новый Массив;

    Для Каждого ЭлементКоличества Из Количества Цикл
        СписокТоваров.Добавить(ЭлементКоличества.Ключ);
        Остатки.Вставить(ЭлементКоличества.Ключ, 0);
    КонецЦикла;

    Если СписокТоваров.Количество() = 0 Тогда
        Возврат Остатки;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Остатки.Товар КАК Товар,
        |    Остатки.КоличествоОстаток КАК КоличествоОстаток
        |ИЗ
        |    РегистрНакопления.ОстаткиТоваров.Остатки(
        |        ,
        |        Склад = &Склад И Товар В (&СписокТоваров)) КАК Остатки";

    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("СписокТоваров", СписокТоваров);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        Остатки.Вставить(Выборка.Товар, Выборка.КоличествоОстаток);
    КонецЦикла;

    Возврат Остатки;

КонецФункции

// При редактировании проведенной расходной накладной текущий остаток
// уже уменьшен ее прежними движениями. Возвращаем их в расчете лимита.
// При переносе документа на другой склад старые движения другого склада
// НЕ прибавляются к остатку текущего склада.
Процедура ДобавитьПрежнийРасход(Остатки, Склад, Регистратор)

    Если Не ЗначениеЗаполнено(Регистратор) Тогда
        Возврат;
    КонецЕсли;

    НаборЗаписей = РегистрыНакопления.ОстаткиТоваров.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
    НаборЗаписей.Прочитать();

    Для Каждого ЗаписьДвижения Из НаборЗаписей Цикл
        Если ЗаписьДвижения.Склад <> Склад
            Или ЗаписьДвижения.ВидДвижения <> ВидДвиженияНакопления.Расход Тогда
            Продолжить;
        КонецЕсли;

        СтароеЗначение = Остатки.Получить(ЗаписьДвижения.Товар);
        Если СтароеЗначение = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Остатки.Вставить(
            ЗаписьДвижения.Товар,
            СтароеЗначение + ЗаписьДвижения.Количество);
    КонецЦикла;

КонецПроцедуры

// Возвращает пустую строку при успехе, текст ошибки при нарушении минимума.
// ПрежнийРегистратор задается ТОЛЬКО для проверки перед записью
// ранее проведенного расходного документа. После Движения.Записать()
// параметр не передавать, иначе прежний расход учтется дважды.
Функция ОшибкаНеснижаемогоОстатка(Склад, Количества, ПрежнийРегистратор = Неопределено) Экспорт

    Остатки = ОстаткиПоТоварам(Склад, Количества);

    Если ПрежнийРегистратор <> Неопределено Тогда
        ДобавитьПрежнийРасход(Остатки, Склад, ПрежнийРегистратор);
    КонецЕсли;

    Для Каждого ЭлементКоличества Из Количества Цикл
        Товар = ЭлементКоличества.Ключ;
        КоличествоКОтпуску = ЭлементКоличества.Значение;
        ОстатокДо = Остатки.Получить(Товар);

        Если ОстатокДо = Неопределено Тогда
            ОстатокДо = 0;
        КонецЕсли;

        ОстатокПосле = ОстатокДо - КоличествоКОтпуску;
        Минимум = Товар.МинимальныйОстаток;

        Если ОстатокПосле < Минимум Тогда
            Возврат СтрШаблон(
                "Склад %1, товар %2: остаток %3, расход %4, минимум %5; после расхода %6. Операция запрещена.",
                Склад, Товар, ОстатокДо, КоличествоКОтпуску, Минимум, ОстатокПосле);
        КонецЕсли;
    КонецЦикла;

    Возврат "";

КонецФункции

// Проверка уже после атомарной записи расходных движений.
// Проверяется фактический остаток КАЖДОГО затронутого товара, а не
// повторное вычитание количества из него.
Функция ОшибкаОстатковПослеДвижений(Склад, Количества) Экспорт

    Остатки = ОстаткиПоТоварам(Склад, Количества);

    Для Каждого ЭлементКоличества Из Количества Цикл
        Товар = ЭлементКоличества.Ключ;
        ОстатокПосле = Остатки.Получить(Товар);

        Если ОстатокПосле = Неопределено Тогда
            ОстатокПосле = 0;
        КонецЕсли;

        Минимум = Товар.МинимальныйОстаток;
        Если ОстатокПосле < Минимум Тогда
            Возврат СтрШаблон(
                "Проведение отклонено: склад %1, товар %2, остаток после записи движений %3, минимум %4.",
                Склад, Товар, ОстатокПосле, Минимум);
        КонецЕсли;
    КонецЦикла;

    Возврат "";

КонецФункции

// Можно вызвать на сервере формы для показа пользователю подсказки.
Функция ДоступноКОтпуску(Склад, Товар) Экспорт

    Если Не ЗначениеЗаполнено(Склад) Или Не ЗначениеЗаполнено(Товар) Тогда
        Возврат 0;
    КонецЕсли;

    Количества = Новый Соответствие;
    Количества.Вставить(Товар, 0);
    Остатки = ОстаткиПоТоварам(Склад, Количества);
    Остаток = Остатки.Получить(Товар);

    Если Остаток = Неопределено Тогда
        Остаток = 0;
    КонецЕсли;

    Возврат Макс(0, Остаток - Товар.МинимальныйОстаток);

КонецФункции

Функция ПолучитьТекущийОстаток(Склад, Товар) Экспорт

    Если Не ЗначениеЗаполнено(Склад) Или Не ЗначениеЗаполнено(Товар) Тогда
        Возврат 0;
    КонецЕсли;

    Количества = Новый Соответствие;
    Количества.Вставить(Товар, 0);
    Остатки = ОстаткиПоТоварам(Склад, Количества);
    Остаток = Остатки.Получить(Товар);

    Если Остаток = Неопределено Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Остаток;

КонецФункции
