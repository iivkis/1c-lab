// Общий модуль СкладскиеОтчетыСервер: Сервер = Истина.
// Данные всех отчетов читаются ТОЛЬКО из регистров накопления.
// Функции возвращают ТаблицаЗначений; формы отчетов и диаграмма подключаются отдельно.

Процедура ПроверитьПараметры(НачалоПериода, КонецПериода, Склад)

    Если Не ЗначениеЗаполнено(Склад) Тогда
        ВызватьИсключение "Для формирования отчета выберите склад.";
    КонецЕсли;

    Если НачалоПериода > КонецПериода Тогда
        ВызватьИсключение "Начало периода должно быть не позже конца.";
    КонецЕсли;

КонецПроцедуры

// №1 — табличный отчет: товар, начальный, приход, расход, конечный,
// неснижаемый минимум и отклонение. Включает и товары без движений.
Функция КонтрольМинимальныхОстатков(НачалоПериода, КонецПериода, Склад) Экспорт

    ПроверитьПараметры(НачалоПериода, КонецПериода, Склад);

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Товары.Ссылка КАК Товар,
        |    ЕСТЬNULL(Обороты.КоличествоНачальныйОстаток, 0) КАК ОстатокНаНачало,
        |    ЕСТЬNULL(Обороты.КоличествоПриход, 0) КАК Приход,
        |    ЕСТЬNULL(Обороты.КоличествоРасход, 0) КАК Расход,
        |    ЕСТЬNULL(Обороты.КоличествоКонечныйОстаток, 0) КАК ОстатокНаКонец,
        |    Товары.МинимальныйОстаток КАК МинимальныйОстаток,
        |    ЕСТЬNULL(Обороты.КоличествоКонечныйОстаток, 0)
        |        - Товары.МинимальныйОстаток КАК Дельта
        |ИЗ
        |    Справочник.Товары КАК Товары
        |        ЛЕВОЕ СОЕДИНЕНИЕ
        |            РегистрНакопления.ОстаткиТоваров.ОстаткиИОбороты(
        |                &НачалоПериода,
        |                &КонецПериода,
        |                ,
        |                ,
        |                Склад = &Склад) КАК Обороты
        |        ПО Товары.Ссылка = Обороты.Товар
        |ГДЕ
        |    НЕ Товары.ЭтоГруппа
        |УПОРЯДОЧИТЬ ПО
        |    Товары.Наименование";

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Запрос.УстановитьПараметр("Склад", Склад);

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// №2 — линейный отчет по поставщикам.
Функция ПоступленияПоставщиков(НачалоПериода, КонецПериода, Склад) Экспорт

    ПроверитьПараметры(НачалоПериода, КонецПериода, Склад);

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    Обороты.Поставщик КАК Поставщик,
        |    Обороты.Товар КАК Товар,
        |    Обороты.КоличествоОборот КАК Количество
        |ИЗ
        |    РегистрНакопления.ПоступленияПоПоставщикам.Обороты(
        |        &НачалоПериода,
        |        &КонецПериода,
        |        ,
        |        Склад = &Склад) КАК Обороты
        |УПОРЯДОЧИТЬ ПО
        |    Поставщик, Товар";

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Запрос.УстановитьПараметр("Склад", Склад);

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

