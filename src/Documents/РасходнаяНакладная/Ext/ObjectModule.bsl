// Документ РасходнаяНакладная.
// Реквизиты: Склад (СправочникСсылка.Склады),
// Получатель (СправочникСсылка.Получатели), ИтогоКоличество (Число 15,3).
// Табличная часть Товары: Товар (СправочникСсылка.Товары), Количество (Число 15,3).
// Движения: ОстаткиТоваров (остатки), ВыдачиПоПолучателям (обороты).

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        Возврат;
    КонецЕсли;

    Ошибка = СкладскойУчетСервер.ОшибкаЗаполненияНакладной(
        Склад, Получатель, Товары);

    Если Ошибка <> "" Тогда
        Сообщить(Ошибка);
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    ИтогоКоличество = Товары.Итог("Количество");
    Количества = СкладскойУчетСервер.КоличестваПоТоварам(Товары);

    ПрежнийРегистратор = Неопределено;

    // Если накладная уже проведена, текущий остаток включает прежний расход.
    Если Не ЭтоНовый() И Проведен Тогда
        ПрежнийРегистратор = Ссылка;
    КонецЕсли;

    // Преподаватель требует запретить даже запись документа с нарушением.
    Ошибка = СкладскойУчетСервер.ОшибкаНеснижаемогоОстатка(
        Склад, Количества, ПрежнийРегистратор);

    Если Ошибка <> "" Тогда
        Сообщить(Ошибка);
        Отказ = Истина;
    КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // Предварительная проверка не заменяет транзакционный контроль:
    // между просмотром формы и проведением могли измениться остатки.
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ВыдачиПоПолучателям.Записывать = Истина;

    Для Каждого СтрокаТовара Из Товары Цикл

        ДвижениеОстатков = Движения.ОстаткиТоваров.ДобавитьРасход();
        ДвижениеОстатков.Период = Дата;
        ДвижениеОстатков.Склад = Склад;
        ДвижениеОстатков.Товар = СтрокаТовара.Товар;
        ДвижениеОстатков.Количество = СтрокаТовара.Количество;

        ДвижениеПолучателя = Движения.ВыдачиПоПолучателям.Добавить();
        ДвижениеПолучателя.Период = Дата;
        ДвижениеПолучателя.Склад = Склад;
        ДвижениеПолучателя.Товар = СтрокаТовара.Товар;
        ДвижениеПолучателя.Получатель = Получатель;
        ДвижениеПолучателя.Количество = СтрокаТовара.Количество;

    КонецЦикла;

    // 1С блокирует изменяемые остатки на время транзакции проведения.
    Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;
    Движения.Записать();

    Количества = СкладскойУчетСервер.КоличестваПоТоварам(Товары);
    Ошибка = СкладскойУчетСервер.ОшибкаОстатковПослеДвижений(
        Склад, Количества);

    Если Ошибка <> "" Тогда
        Сообщить(Ошибка);
        Отказ = Истина; // Транзакция проведения откатит все движения.
    КонецЕсли;

КонецПроцедуры
