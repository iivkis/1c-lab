&НаКлиенте
Процедура ПересчитатьИтого()
    Итог = 0;
    Для Каждого СтрокаТоваров Из Объект.Товары Цикл
        Итог = Итог + СтрокаТоваров.Количество;
    КонецЦикла;
    Объект.ИтогоКоличество = Итог;
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
    ОбновитьОстатки();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)
    ПересчитатьИтого();
    ОбновитьОстатки();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
    ПересчитатьИтого();
    ОбновитьОстатки();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОстатки()
    СтрокаТоваров = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТоваров = Неопределено Тогда
        ОбновитьОстаткиНаСервере(Неопределено);
    Иначе
        ОбновитьОстаткиНаСервере(СтрокаТоваров.Товар);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиНаСервере(Товар)

    ОстатокТовара = 0;
    МинимальныйОстаток = 0;
    ДоступноКОтпуску = 0;
    ОстатокПосле = 0;

    Если Не ЗначениеЗаполнено(Товар) Или Не ЗначениеЗаполнено(Объект.Склад) Тогда
        Возврат;
    КонецЕсли;

    // Суммируем все строки этого товара, иначе повтор товара показывает
    // ложный прогноз, хотя контроль объекта уже правильно суммирует расход.
    РасходПоТовару = 0;
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        Если СтрокаТовара.Товар = Товар Тогда
            РасходПоТовару = РасходПоТовару + СтрокаТовара.Количество;
        КонецЕсли;
    КонецЦикла;

    // При редактировании уже проведённой накладной учитываем её
    // собственные прежние движения, относящиеся к текущему складу.
    ПрежнийРегистратор = Неопределено;
    Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
        ПрежнийРегистратор = Объект.Ссылка;
    КонецЕсли;

    ОстатокТовара = СкладскойУчетСервер.ПолучитьОстатокДоРасхода(
        Объект.Склад, Товар, ПрежнийРегистратор);
    МинимальныйОстаток = Товар.МинимальныйОстаток;
    ДоступноКОтпуску = Макс(0, ОстатокТовара - МинимальныйОстаток);
    ОстатокПосле = ОстатокТовара - РасходПоТовару;

КонецПроцедуры

&НаСервере
Функция ПостроитьПечатныйДокумент()

    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Область("R1C1").Текст = "Расходная накладная";
    ТабДок.Область("R2C1").Текст = "Номер";
    ТабДок.Область("R2C2").Текст = Строка(Объект.Номер);
    ТабДок.Область("R3C1").Текст = "Дата";
    ТабДок.Область("R3C2").Текст = Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
    ТабДок.Область("R4C1").Текст = "Склад";
    ТабДок.Область("R4C2").Текст = Строка(Объект.Склад);
    ТабДок.Область("R5C1").Текст = "Получатель";
    ТабДок.Область("R5C2").Текст = Строка(Объект.Получатель);
    ТабДок.Область("R7C1").Текст = "Товар";
    ТабДок.Область("R7C2").Текст = "Количество";

    НомерСтроки = 8;
    Итог = 0;
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        ТабДок.Область("R" + Строка(НомерСтроки) + "C1").Текст = Строка(СтрокаТовара.Товар);
        ТабДок.Область("R" + Строка(НомерСтроки) + "C2").Текст = Формат(СтрокаТовара.Количество, "ЧДЦ=3");
        Итог = Итог + СтрокаТовара.Количество;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;

    ТабДок.Область("R" + Строка(НомерСтроки) + "C1").Текст = "ИТОГО";
    ТабДок.Область("R" + Строка(НомерСтроки) + "C2").Текст = Формат(Итог, "ЧДЦ=3");
    Возврат ТабДок;

КонецФункции

&НаКлиенте
Процедура Печать(Команда)
    ДокументПечати = ПостроитьПечатныйДокумент();
    ДокументПечати.Показать("Расходная накладная");
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортВExcel(Команда)

    // Конфигурация работает в режиме DontUse, модальное Выбрать() запрещено.
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = "Файл Excel (*.xlsx)|*.xlsx";
    Диалог.ПолноеИмяФайла = "РасходнаяНакладная.xlsx";
    Диалог.Показать(Новый ОписаниеОповещения(
        "ЭкспортВExcelЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортВExcelЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Если ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Попытка
        ДокументПечати = ПостроитьПечатныйДокумент();
        ДокументПечати.Записать(
            ВыбранныеФайлы[0],
            ТипФайлаТабличногоДокумента.XLSX);
        Сообщить("Выгрузка накладной завершена: " + ВыбранныеФайлы[0]);
    Исключение
        Сообщить("Ошибка экспорта Excel: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
