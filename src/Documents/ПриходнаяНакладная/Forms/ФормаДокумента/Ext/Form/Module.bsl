&НаСервере
Функция ПостроитьПечатныйДокумент()

    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Область("R1C1").Текст = "Приходная накладная";
    ТабДок.Область("R2C1").Текст = "Номер";
    ТабДок.Область("R2C2").Текст = Строка(Объект.Number);
    ТабДок.Область("R3C1").Текст = "Дата";
    ТабДок.Область("R3C2").Текст = Формат(Объект.Date, "ДФ=dd.MM.yyyy");
    ТабДок.Область("R4C1").Текст = "Склад";
    ТабДок.Область("R4C2").Текст = Строка(Объект.Склад);
    ТабДок.Область("R5C1").Текст = "Поставщик";
    ТабДок.Область("R5C2").Текст = Строка(Объект.Поставщик);
    ТабДок.Область("R7C1").Текст = "Товар";
    ТабДок.Область("R7C2").Текст = "Количество";

    НомерСтроки = 8;
    Итог = 0;
    Для Каждого СтрокаТовара Из Объект.Товары Цикл
        ТабДок.Область("R" + Строка(НомерСтроки) + "C1").Текст = Строка(СтрокаТовара.Товар);
        ТабДок.Область("R" + Строка(НомерСтроки) + "C2").Текст = Формат(СтрокаТовара.Количество, "ЧДЦ=3");
        Итог = Итог + СтрокаТовара.Количество;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;

    ТабДок.Область("R" + Строка(НомерСтроки) + "C1").Текст = "ИТОГО";
    ТабДок.Область("R" + Строка(НомерСтроки) + "C2").Текст = Формат(Итог, "ЧДЦ=3");
    Возврат ТабДок;

КонецФункции

&НаКлиенте
Процедура Печать(Команда)
    ДокументПечати = ПостроитьПечатныйДокумент();
    ДокументПечати.Показать("Приходная накладная");
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортВExcel(Команда)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = "Файл Excel (*.xlsx)|*.xlsx";
    Диалог.ПолноеИмяФайла = "ПриходнаяНакладная.xlsx";
    Если Диалог.Выбрать() Тогда
        ДокументПечати = ПостроитьПечатныйДокумент();
        ДокументПечати.Записать(
            Диалог.ПолноеИмяФайла,
            ТипФайлаТабличногоДокумента.XLSX);
        Сообщить("Выгрузка накладной завершена: " + Диалог.ПолноеИмяФайла);
    КонецЕсли;

КонецПроцедуры
