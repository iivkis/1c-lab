// Документ ПриходнаяНакладная.
// Реквизиты: Склад (СправочникСсылка.Склады),
// Поставщик (СправочникСсылка.Поставщики), ИтогоКоличество (Число 15,3).
// Табличная часть Товары: Товар (СправочникСсылка.Товары), Количество (Число 15,3).
// Движения: ОстаткиТоваров (остатки), ПоступленияПоПоставщикам (обороты).

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        Возврат;
    КонецЕсли;

    Ошибка = СкладскойУчетСервер.ОшибкаЗаполненияНакладной(
        Склад, Поставщик, Товары);

    Если Ошибка <> "" Тогда
        Сообщить(Ошибка);
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    ИтогоКоличество = Товары.Итог("Количество");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ПоступленияПоПоставщикам.Записывать = Истина;

    Для Каждого СтрокаТовара Из Товары Цикл

        ДвижениеОстатков = Движения.ОстаткиТоваров.ДобавитьПриход();
        ДвижениеОстатков.Период = Дата;
        ДвижениеОстатков.Склад = Склад;
        ДвижениеОстатков.Товар = СтрокаТовара.Товар;
        ДвижениеОстатков.Количество = СтрокаТовара.Количество;

        ДвижениеПоставщика = Движения.ПоступленияПоПоставщикам.Добавить();
        ДвижениеПоставщика.Период = Дата;
        ДвижениеПоставщика.Склад = Склад;
        ДвижениеПоставщика.Товар = СтрокаТовара.Товар;
        ДвижениеПоставщика.Поставщик = Поставщик;
        ДвижениеПоставщика.Количество = СтрокаТовара.Количество;

    КонецЦикла;

КонецПроцедуры
